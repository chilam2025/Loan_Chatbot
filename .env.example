POSTGRES_DB=abc_credit
POSTGRES_USER=abc_credit
POSTGRES_PASSWORD=change-this-local-password
ABC_DATABASE_URL=postgresql+psycopg://abc_credit:change-this-local-password@db:5432/abc_credit
ABC_MODEL_PROVIDER=trained
ABC_MODEL_PATH=/app/models/catboost_minimal_v2/decision_model.joblib
ABC_REFERENCE_TABLES_PATH=/app/models/reference/reference_tables.json
ABC_CORS_ORIGINS=http://localhost:8080
ABC_LOG_LEVEL=INFO

# Conversational guidance (the assistant never makes the credit decision).
ABC_ASSISTANT_PROVIDER=disabled
ABC_OLLAMA_MODEL=qwen3:4b
ABC_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Use msg91 only after DLT, sender and template approval. Never commit the key.
ABC_OTP_PROVIDER=mock
ABC_VERIFICATION_HASH_KEY=replace-with-at-least-32-random-characters
ABC_MSG91_AUTH_KEY=
ABC_MSG91_TEMPLATE_ID=

# Use protean only after entity registration and UAT certification.
ABC_PAN_PROVIDER=mock
ABC_PROTEAN_USER_ID=
ABC_PROTEAN_PRIVATE_KEY_PATH=/run/secrets/protean-private-key.pem
ABC_PROTEAN_PRIVATE_KEY_PASSWORD=
ABC_PROTEAN_ENDPOINT=https://opvapi.egov-nsdl.com/TIN/PanInquiryAPIBackEnd
